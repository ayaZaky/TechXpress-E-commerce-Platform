@model IEnumerable< TechXpress.Data.Entities.Order>
@using System.Text.Json

@{
    ViewData["Title"] = "Orders";
    Layout = "~/Areas/Admin/Views/Shared/_LayoutDashboard.cshtml";
}
@using TechXpress.Data.Entities.Enums

<div class="container-fluid">    
        <h2 class="mb-4">Orders</h2>
        <table id="ordersTable" class="table table-striped">
            <thead>
                <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Order Status</th>    
                    <th>Total Price</th>  
                    <th>Actions</th>
                </tr>
            </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var order in Model)
                {
                    <tr>
                        <td>@order.Id</td>   
                        <td>@(order.User != null ? $"{order.User.FirstName} {order.User.LastName}" : "Unknown User")</td>
                        <td> @order.OrderDate </td>
                        <td>

                            @{
                                 
                                string badgeClass = "";
                                switch (order.OrderStatus)
                                {
                                    case OrderStatus.Delivered:
                                        badgeClass = "bg-success";
                                        break;
                                    case OrderStatus.Pending:
                                        badgeClass = "bg-warning text-dark";
                                        break;
                                    case OrderStatus.Processing:
                                        badgeClass = "bg-primary";
                                        break;  
                                    case OrderStatus.Cancelled:
                                        badgeClass = "bg-danger";
                                        break; 
                                    default:
                                        badgeClass = "bg-secondary";
                                        break;
                                }
                            }
                            <span class="badge @badgeClass">@order.OrderStatus</span>
                        </td>  
						 
                        <td>
                            @order.OrderTotal EGP
                        </td>

                        <td>
                            @{
                                var itemsJson = JsonSerializer.Serialize(order.OrderItems.Select(oi => new
                                {
                                    ProductName = oi.Product?.Name ?? "Unknown Product",
                                    Quantity = oi.Quantity,
                                    Price = oi.UnitPrice
                                }));
                            }
                            <button class="btn btn-sm btn-primary view-order"
                                    data-bs-toggle="modal"
                                    data-bs-target="#viewOrderModal"
                                    data-order-id="@order.Id"
                                    data-customer="@($"{order.User.FirstName} {order.User.LastName}")"
                                    data-date="@order.OrderDate.ToString("yyyy-MM-dd")"
                                    data-status="@order.OrderStatus"
                                    data-total="@order.OrderTotal"
                                    data-items='@Html.Raw(itemsJson)'>
                                <i class="fas fa-eye"></i>
                            </button>
                            <button type="button" class="btn btn-sm btn-success update-order-status"
                                    data-bs-toggle="modal"
                                    data-bs-target="#updateOrderStatusModal"
                                    data-orderid="@order.Id">
                                <i class="fas fa-check"></i>
                            </button>

                          @*   <button class="btn btn-sm btn-success update-order-status" data-bs-toggle="modal" data-bs-target="#updateOrderStatusModal"><i class="fas fa-check"></i></button> *@
                          
                        </td>


                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center">No Orders Found</td>
                </tr>
            }

          
        </tbody>
    </table>
</div>
<!-- View Order Modal -->
<div class="modal fade" id="viewOrderModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Order Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6>Order ID</h6>
                        <p class="order-id"></p>
                    </div>
                    <div class="col-md-6">
                        <h6>Customer</h6>
                        <p class="order-customer"></p>
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6>Date</h6>
                        <p class="order-date"></p>
                    </div>
                    <div class="col-md-6">
                        <h6>Status</h6>
                        <p class="order-status"></p>
                    </div>
                </div>
                <div class="mb-3">
                    <h6>Items</h6>
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Quantity</th>
                                <th>Price</th>
                            </tr>
                        </thead>
                        <tbody class="order-items">
                        </tbody>
                    </table>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <h6>Shipping Address</h6>
                        <p class="order-address"></p>
                    </div>
                    <div class="col-md-6">
                        <h6>Payment Method</h6>
                        <p class="order-payment"></p>
                    </div>
                </div>
                <div class="mb-3">
                    <h6>Total</h6>
                    <p class="order-total"></p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Update Order Status Modal -->
<div class="modal fade" id="updateOrderStatusModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Update Order Status</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="updateOrderForm" method="post" asp-area="Admin" asp-action="UpdateStatus" asp-controller="Order" class="needs-validation" novalidate>
                    @Html.AntiForgeryToken()

                    <input type="hidden" name="id" id="orderIdInput" />

                    <div class="mb-3">
                        <label for="orderStatus" class="form-label">Status</label>
                        <select class="form-select" name="status" id="orderStatus" required>
                            <option value="">Select Status</option>
                            <option value="Pending">Pending</option>
                            <option value="Processing">Processing</option>
                            <option value="Shipped">Shipped</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                        <div class="invalid-feedback">
                            Please select a status
                        </div>
                    </div>
                </form>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="updateOrderForm" class="btn btn-primary">Update Status</button>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // التعامل مع مودال عرض الطلب
            document.querySelectorAll('.view-order').forEach(button => {
                button.addEventListener('click', function () {
                    const modal = document.querySelector('#viewOrderModal');

                    modal.querySelector('.order-id').innerText = this.dataset.orderId;
                    modal.querySelector('.order-customer').innerText = this.dataset.customer;
                    modal.querySelector('.order-date').innerText = this.dataset.date;
                    modal.querySelector('.order-status').innerText = this.dataset.status;
                    modal.querySelector('.order-total').innerText = this.dataset.total + ' EGP';
                    modal.querySelector('.order-address').innerText = this.dataset.address || 'N/A';

                    // Parse items
                    const items = JSON.parse(this.dataset.items);
                    const itemsBody = modal.querySelector('.order-items');
                    itemsBody.innerHTML = '';

                    items.forEach(item => {
                        const row = `<tr>
                                        <td>${item.ProductName}</td>
                                        <td>${item.Quantity}</td>
                                        <td>${item.Price} EGP</td>
                                     </tr>`;
                        itemsBody.innerHTML += row;
                    });
                });
            });

            // مودال تعديل الحالة
            $('#updateOrderStatusModal').on('show.bs.modal', function (event) {
                var button = $(event.relatedTarget);
                var orderId = button.data('orderid');

                $('#orderIdInput').val(orderId);
            });
        });
    </script>
}
